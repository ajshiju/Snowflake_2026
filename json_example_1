    SELECT src:salesperson.name
    FROM car_sales
    ORDER BY 1;

       SELECT
       src:customer[0].name ,   -- array of object 
       src:customer[0].address,
       src:date ,
       src:salesperson, 
       src:salesperson.id,   -- coz its just a single object 
       src:salesperson.name::VARCHAR as name
       
    FROM car_sales
    ORDER BY 1;



--By default, when VARCHARs, DATEs, TIMEs, and TIMESTAMPs are retrieved from a VARIANT column, the values are surrounded by double quotes. You can eliminate the double quotes by explicitly casting the values. For example:

SELECT src:vehicle[0].price::NUMBER * 0.10 AS tax  -- remvoing the double quotes
    FROM car_sales
    ORDER BY tax;


SELECT src:vehicle[0].price::NUMBER as tax
    FROM car_sales
    ORDER BY tax;


SELECT src:dealership, src:dealership::VARCHAR
    FROM car_sales
    ORDER BY 2;



SELECT
  c.value:name::string as "Customer Name",
  c.value:address::string as "Address",
  v.value:make::varchar as "Make",
src:salesperson.name::string,
src:salesperson.id::string,
  FROM
    car_sales
  , LATERAL FLATTEN(INPUT => SRC:customer) c
  , LATERAL FLATTEN(INPUT => SRC:vehicle) v



SELECT
  vm.value:make::string as make,
  vm.value:model::string as model,
  ve.value::string as "Extras Purchased"
  FROM
    car_sales
    , LATERAL FLATTEN(INPUT => src:vehicle) vm
    , LATERAL FLATTEN(INPUT => vm.value:extras) ve
  ORDER BY make, model, "Extras Purchased";




