Snowflake Secure Data Sharing — Complete Syntax Guide
PROVIDER SIDE — Full Syntax
Step 1 — Create a Share
sql
-- Basic share creation
CREATE SHARE my_share;

-- Create share with comment
CREATE SHARE my_share
COMMENT = 'Share for client ABC';

-- View all shares created by provider
SHOW SHARES;

-- Describe a specific share
DESCRIBE SHARE my_share;
Step 2 — Grant Privileges to the Share
sql
-- IMPORTANT: Must follow this exact order:
-- 1. Database → 2. Schema → 3. Object

-- Step 2a: Grant access to the DATABASE
GRANT USAGE ON DATABASE my_database
TO SHARE my_share;

-- Step 2b: Grant access to the SCHEMA
GRANT USAGE ON SCHEMA my_database.my_schema
TO SHARE my_share;

-- Step 2c: Grant access to specific TABLES
GRANT SELECT ON TABLE my_database.my_schema.my_table
TO SHARE my_share;

-- Grant access to MULTIPLE tables at once
GRANT SELECT ON TABLE my_database.my_schema.table_1,
               my_database.my_schema.table_2,
               my_database.my_schema.table_3
TO SHARE my_share;

-- Grant access to ALL tables in a schema
GRANT SELECT ON ALL TABLES
IN SCHEMA my_database.my_schema
TO SHARE my_share;
Grant Secure Views & Other Objects
sql
-- Grant access to a SECURE VIEW
GRANT SELECT ON VIEW my_database.my_schema.my_secure_view
TO SHARE my_share;

-- Grant access to a SECURE MATERIALIZED VIEW
GRANT SELECT ON MATERIALIZED VIEW my_database.my_schema.my_secure_mv
TO SHARE my_share;

-- Grant access to a SECURE UDF
GRANT USAGE ON FUNCTION my_database.my_schema.my_secure_udf(VARCHAR)
TO SHARE my_share;

-- Grant access to an EXTERNAL TABLE
GRANT SELECT ON EXTERNAL TABLE my_database.my_schema.my_ext_table
TO SHARE my_share;
Step 3 — Add Consumer Accounts to the Share
sql
-- Add a single consumer account
ALTER SHARE my_share
ADD ACCOUNTS = consumer_org.consumer_account;

-- Add multiple consumer accounts at once
ALTER SHARE my_share
ADD ACCOUNTS = consumer_org.account_1,
               consumer_org.account_2,
               consumer_org.account_3;

-- Remove a specific consumer account
ALTER SHARE my_share
REMOVE ACCOUNTS = consumer_org.consumer_account;

-- Remove multiple consumer accounts
ALTER SHARE my_share
REMOVE ACCOUNTS = consumer_org.account_1,
                  consumer_org.account_2;
Revoking Grants from a Share
sql
-- Revoke access to a specific TABLE
REVOKE SELECT ON TABLE my_database.my_schema.my_table
FROM SHARE my_share;

-- Revoke access to a SCHEMA
REVOKE USAGE ON SCHEMA my_database.my_schema
FROM SHARE my_share;

-- Revoke access to the DATABASE
REVOKE USAGE ON DATABASE my_database
FROM SHARE my_share;

-- Revoke access to a SECURE VIEW
REVOKE SELECT ON VIEW my_database.my_schema.my_secure_view
FROM SHARE my_share;
Managing & Dropping Shares
sql
-- View all objects granted to a share
SHOW GRANTS TO SHARE my_share;

-- View all accounts added to a share
SHOW GRANTS OF SHARE my_share;

-- Drop a share entirely
DROP SHARE my_share;

-- Alter share comment
ALTER SHARE my_share
SET COMMENT = 'Updated share description';
Creating Secure Objects to Share
sql
-- Create a SECURE VIEW (recommended over sharing raw tables)
CREATE OR REPLACE SECURE VIEW my_database.my_schema.my_secure_view AS
SELECT
    customer_id,
    customer_name,
    region
    -- Sensitive columns like SSN, salary are excluded
FROM my_database.my_schema.customers
WHERE region = 'EMEA';

-- Create a SECURE MATERIALIZED VIEW
CREATE OR REPLACE SECURE MATERIALIZED VIEW my_database.my_schema.my_secure_mv AS
SELECT
    product_id,
    SUM(sales_amount) AS total_sales
FROM my_database.my_schema.sales
GROUP BY product_id;

-- Create a SECURE UDF
CREATE OR REPLACE SECURE FUNCTION my_database.my_schema.mask_email(email VARCHAR)
RETURNS VARCHAR
LANGUAGE JAVASCRIPT AS
$$
  return EMAIL.replace(/^(.{2}).*(@.*)$/, '$1***$2');
$$;
CONSUMER SIDE — Full Syntax
Step 1 — Discover Available Shares
sql
-- List all shares available to this account
SHOW SHARES;

-- Describe what objects are in a share
DESCRIBE SHARE provider_org.provider_account.my_share;

-- Show all incoming shares only
SHOW SHARES LIKE 'my_share%';
Step 2 — Create Database from Share
sql
-- Create a database from the share
CREATE DATABASE my_shared_db
FROM SHARE provider_org.provider_account.my_share;

-- Only ONE database can be created per share
-- Running this again will produce an error

-- View the newly created shared database
SHOW DATABASES;

-- See all objects available in the shared database
SHOW TABLES IN DATABASE my_shared_db;
SHOW VIEWS IN DATABASE my_shared_db;
Step 3 — Query Shared Data
sql
-- Query a shared table
SELECT * FROM my_shared_db.my_schema.my_table;

-- Filter shared data
SELECT *
FROM my_shared_db.my_schema.my_table
WHERE region = 'EMEA'
LIMIT 100;

-- JOIN shared data with your own native tables
SELECT
    s.customer_id,
    s.customer_name,
    o.order_id,
    o.order_amount
FROM my_shared_db.my_schema.customers s
JOIN my_own_db.my_schema.orders o
    ON s.customer_id = o.customer_id;

-- Aggregate shared data
SELECT
    region,
    COUNT(*) AS total_customers,
    SUM(revenue) AS total_revenue
FROM my_shared_db.my_schema.customers
GROUP BY region
ORDER BY total_revenue DESC;
READER ACCOUNTS — Full Syntax
sql
-- Create a reader account (run by PROVIDER)
CREATE MANAGED ACCOUNT reader_account_1
ADMIN_NAME = 'admin_user'
ADMIN_PASSWORD = 'SecurePassword123!'
TYPE = READER
COMMENT = 'Reader account for client XYZ';

-- View all reader accounts created
SHOW MANAGED ACCOUNTS;

-- Grant share access to reader account
ALTER SHARE my_share
ADD ACCOUNTS = <reader_account_locator>;

-- Drop a reader account
DROP MANAGED ACCOUNT reader_account_1;
DELEGATION OF PRIVILEGES
sql
-- Delegate CREATE SHARE privilege to another role
-- (so roles other than ACCOUNTADMIN can create shares)
GRANT CREATE SHARE ON ACCOUNT
TO ROLE data_share_manager;

-- Delegate IMPORT SHARE privilege to another role
-- (so roles other than ACCOUNTADMIN can import shares)
GRANT IMPORT SHARE ON ACCOUNT
TO ROLE data_consumer_role;
MONITORING & AUDITING SHARES
sql
-- Show all shares (both incoming and outgoing)
SHOW SHARES;

-- Show all grants TO a specific share
SHOW GRANTS TO SHARE my_share;

-- Show all accounts that have access to a share
SHOW GRANTS OF SHARE my_share;

-- Monitor share usage via Account Usage
SELECT *
FROM SNOWFLAKE.ACCOUNT_USAGE.DATA_SHARING_USAGE_HISTORY
WHERE SHARE_NAME = 'MY_SHARE'
ORDER BY USAGE_DATE DESC;
COMPLETE END-TO-END EXAMPLE
sql
-- ============================================
-- PROVIDER ACCOUNT
-- ============================================

-- 1. Create secure view to share safely
CREATE OR REPLACE SECURE VIEW sales_db.public.regional_sales_view AS
SELECT
    region,
    product_category,
    SUM(sales_amount) AS total_sales,
    COUNT(order_id)   AS total_orders
FROM sales_db.public.orders
GROUP BY region, product_category;

-- 2. Create the share
CREATE SHARE client_share;

-- 3. Grant object hierarchy to share
GRANT USAGE ON DATABASE sales_db               TO SHARE client_share;
GRANT USAGE ON SCHEMA   sales_db.public        TO SHARE client_share;
GRANT SELECT ON VIEW    sales_db.public.regional_sales_view
                                               TO SHARE client_share;

-- 4. Add consumer accounts
ALTER SHARE client_share
ADD ACCOUNTS = consumer_org.client_account_1,
               consumer_org.client_account_2;

-- 5. Verify setup
SHOW GRANTS TO SHARE client_share;
SHOW GRANTS OF SHARE client_share;


-- ============================================
-- CONSUMER ACCOUNT
-- ============================================

-- 1. Discover available shares
SHOW SHARES;

-- 2. Inspect share contents
DESCRIBE SHARE provider_org.provider_account.client_share;

-- 3. Create database from share
CREATE DATABASE client_shared_db
FROM SHARE provider_org.provider_account.client_share;

-- 4. Query shared data
SELECT * FROM client_shared_db.public.regional_sales_view;

-- 5. Join with own data
SELECT
    s.region,
    s.total_sales,
    t.sales_target,
    (s.total_sales - t.sales_target) AS variance
FROM client_shared_db.public.regional_sales_view s
JOIN my_own_db.public.sales_targets t
    ON s.region = t.region;
