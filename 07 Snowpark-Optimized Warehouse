Snowpark-Optimized Syntax
Create Snowpark-Optimized Warehouse
CREATE WAREHOUSE snowpark_wh
WITH
WAREHOUSE_SIZE = 'MEDIUM'
WAREHOUSE_TYPE = 'SNOWPARK-OPTIMIZED';
Example with Auto Suspend
CREATE WAREHOUSE ml_wh
WITH
WAREHOUSE_SIZE = 'LARGE'
WAREHOUSE_TYPE = 'SNOWPARK-OPTIMIZED'
AUTO_SUSPEND = 300
AUTO_RESUME = TRUE;
Use Warehouse
USE WAREHOUSE ml_wh;
Show Warehouses
SHOW WAREHOUSES;
Describe Warehouse
DESCRIBE WAREHOUSE ml_wh;
Resize Warehouse
ALTER WAREHOUSE ml_wh
SET WAREHOUSE_SIZE = 'XLARGE';
Suspend Warehouse
ALTER WAREHOUSE ml_wh SUSPEND;
Resume Warehouse
ALTER WAREHOUSE ml_wh RESUME;
